<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LocalScribe.Core\LocalScribe.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- MIT. Owns its OWN llama.cpp native runtimes (CPU + CUDA 12) in THIS process only.
         The App must NEVER reference these packages or this project - same native-DLL
         isolation rationale as Diarizer's sherpa/ORT split (LocalScribe.App.csproj:24-52).
         Publish: FOLDER publish into an assistant\ subfolder beside the App (design 2026-07-23) -
         single-file is IMPOSSIBLE here: LLamaSharp probes runtimes/<rid>/native/<variant>/
         relative to the app directory itself; self-extract lands the natives where that probe
         never looks and every request fails at NativeApi init. The assistant\ subfolder keeps
         this exe's own onnxruntime.dll isolated from the App's (same isolation goal as
         Diarizer's single-file rule, reached by a different means).
         CUDA functions on win-x64 only; on ARM64 the CPU backend is the sole path. -->
    <!-- 2026-07-25 (Task 9 semantic-search smoke): bumped 0.25.0 -> 0.27.0 IN LOCKSTEP across
         all three packages. 0.25.0's vendored llama.cpp does not recognize the "gemma-embedding"
         architecture (EmbeddingGemma-300m GGUF fails to load: "unknown model architecture:
         'gemma-embedding'"); 0.27.0 loads it (verified: tools/smoke-embed.ps1 PASS). LlamaEngine's
         chat wrapper/backend-selection code is untouched by this bump; the chat model was
         confirmed to still build and its manifest fetch/verify path re-run (Task 9), but a
         real-weights chat INFERENCE smoke against 0.27.0 was not re-run here (out of this task's
         scope) - flag for the App-wiring/full-gate task if a template regression is suspected. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" />
  </ItemGroup>

  <!-- The folder publish and LLamaSharp's native layout need reconciling (design 2026-07-23
       section 1; replaces the former single-file-only target). The backend packages ship the
       SAME llama.cpp filenames (llama.dll, ggml.dll, ggml-base.dll, mtmd.dll) once per hardware
       variant: CPU -> native/{avx,avx2,avx512,noavx}/, CUDA -> native/cuda12/. LlamaEngine and
       tools/verify-assistant-publish.ps1 need these under the OUTPUT path runtimes/win-x64/native/
       <variant>/ (that's where LLamaSharp's loader probes, relative to AppContext.BaseDirectory).
       2026-07-25 (LLamaSharp 0.25.0 -> 0.27.0 bump, Task 9 semantic-search follow-up): 0.27.0
       moved the physical package layout from runtimes/<rid>/native/<variant>/ to
       LLamaSharpRuntimes/<rid>/native/<variant>/ (each backend package's own build/*.props copies
       these as Content with Link="runtimes\$(RuntimeIdentifier)\..." - i.e. the SDK's own props
       already put them back under an output-side "runtimes/" folder, just not split by variant:
       without this target's RelativePath rewrite every variant's same-named DLLs collide on
       Content's own default TargetPath and dotnet publish hard-fails with NETSDK1152 duplicate-
       publish-file, rather than 0.25.0's old silent flattened-noavx failure mode). This target now
       does two things: (a) anchors on the physical LLamaSharpRuntimes/win-x64/ source path (not
       the pre-0.27.0 runtimes/ one - the old regex silently matched zero characters against
       0.27.0's paths because "LLamaSharpRuntimes" has a capital R, so ALL native files collapsed
       onto the identical bogus RelativePath "runtimes/" instead of raising a build error, which is
       what surfaced this) and rewrites RelativePath to runtimes/win-x64/native/<variant>/<file>,
       gated to win-x64 sources only (LLamaSharp.Backend.Cuda12 0.27.0 depends on BOTH a
       cuda12.windows and a cuda12.linux sub-package; the linux one's props Content fallback fires
       whenever ITS OWN win-x64 folder doesn't exist and grabs its .so files unconditionally
       regardless of our target RID - harmless since they land under a non-colliding
       runtimes/linux-x64/... path this target never touches, but real 0.27.0 packaging noise worth
       knowing about); (b) co-locates the avx2 ggml-cpu.dll into cuda12/ - the CUDA ggml.dll
       IMPORTS ggml-cpu.dll at load time (verified 2026-07-23, re-verified true under 0.27.0 by
       publishing with this step removed: the cuda12.windows package still ships only 5 files
       [ggml-base/ggml-cuda/ggml/llama/mtmd] with no ggml-cpu.dll of its own; without this step the
       CUDA set is incomplete and the CPU backend also computes the non-offloaded graph parts).
       DROPPED under 0.27.0 (verified redundant by publishing without it and diffing the output):
       the former step (b) "re-inject the 4 CUDA natives conflict-resolution silently dropped" -
       0.27.0 ships these as plain Content items, which never enter the old RID-native-asset
       dedup pipeline that used to drop them in 0.25.0, so nothing drops them anymore.
       LLamaSharp's loader picks the CPU variant by runtime CPU detection (verified: avx2 on
       an AVX2 box); the CUDA path is engaged explicitly by LlamaEngine via WithLibrary,
       because LLamaSharp's own CUDA detection needs the CUDA toolkit end users don't have.
       On arm64 no cuda12 assets exist, the anchor is empty, and (b) is a no-op.
       LOAD-BEARING: if this regresses, the publish either hard-fails with NETSDK1152 or (if the
       regex silently stops matching again) reverts to a broken/incomplete layout -
       tools/verify-assistant-publish.ps1 (run after every publish) exists to catch that. -->
  <Target Name="_PreserveLlamaCppNativeLayout"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
          Condition="$([System.String]::new('%(ResolvedFileToPublish.Identity)').Replace('\', '/').Contains('/llamasharp.backend.')) And $([System.String]::new('%(ResolvedFileToPublish.Identity)').Replace('\', '/').Contains('/LLamaSharpRuntimes/win-x64/'))">
        <RelativePath>runtimes/win-x64/$([System.Text.RegularExpressions.Regex]::Match($([System.String]::new('%(ResolvedFileToPublish.Identity)').Replace('\', '/')), '/LLamaSharpRuntimes/win-x64/(.*)$').Groups[1].Value)</RelativePath>
      </ResolvedFileToPublish>

      <_LlamaAvx2CpuAnchor Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::new('%(ResolvedFileToPublish.Identity)').Replace('\', '/').Contains('/avx2/ggml-cpu.dll'))" />

      <ResolvedFileToPublish Include="@(_LlamaAvx2CpuAnchor->'%(FullPath)')">
        <RelativePath>runtimes/win-x64/native/cuda12/ggml-cpu.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
