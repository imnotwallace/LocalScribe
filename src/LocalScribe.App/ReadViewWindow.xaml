<ui:FluentWindow x:Class="LocalScribe.App.ReadViewWindow" x:Name="Self"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LocalScribe.App"
        xmlns:vm="clr-namespace:LocalScribe.App.ViewModels"
        xmlns:controls="clr-namespace:LocalScribe.App.Controls"
        Title="{Binding Title}" Height="560" Width="720" MinHeight="300" MinWidth="420"
        WindowBackdropType="None" ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:ReadViewStampConverter x:Key="Stamp" />
        <!-- Task 16: split-child sub-second editor. Whole (unsplit) segments keep the read-only
             Stamp converter above; only a split child's derived start is user-editable, since only
             that start is an estimate (design §3.3). -->
        <local:MsTimestampConverter x:Key="MsStamp" />
        <!-- The row context menu is declared inside a ListViewItem Style.Setter, so its runtime
             DataContext is the ReadRow, and (unlike a direct child) the XAML compiler does NOT wire
             Click="..." handlers on menu items nested there. Route to the window's commands instead
             (same fix SessionsPage uses via VmProxy). Data is set to the window in the code-behind
             ctor, so Data.<Command> reaches the ReadViewWindow's own commands; CommandParameter
             stays the local ReadRow. -->
        <local:BindingProxy x:Key="WindowProxy" />
    </Window.Resources>
    <!-- Display controls plus Stage 6.1's two edit affordances: the row context menu opens the
         Correct text / Reassign speaker dialogs; everything else remains read-only. -->
    <DockPanel TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True" />
        <DockPanel Margin="12">
        <!-- Edit-mode save failures surface HERE (this window), not MainWindow's InfoBar the user
             can't see. IsClosable=False: it reflects state and clears on a clean save/cancel. -->
        <ui:InfoBar DockPanel.Dock="Top" Margin="0,0,0,8" Title="Couldn't save your edits"
                    Severity="Error" IsClosable="False"
                    IsOpen="{Binding HasSaveError, Mode=OneWay}"
                    Message="{Binding SaveError}" />
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <!-- WrapPanel (not a non-wrapping StackPanel) so the header's info + action buttons wrap
                 to a second row instead of the rightmost button ("Manage speakers...") clipping off
                 the window edge when narrowed - same house pattern as the playback cluster below. -->
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding DateDisplay}" Margin="0,0,12,4" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DurationDisplay}" Margin="0,0,12,4" VerticalAlignment="Center" />
                <!-- F1(a) whole-branch review fix: disabled for the whole of Edit mode (kills the
                     deterministic version-bleed path - edit v2, switch the dropdown to v1, Save
                     would silently write v2's corrections into v1's root edits.json). WPF has no
                     built-in bool-invert; same house fallback the Edit button's Style.Triggers use
                     right below (a MultiDataTrigger) and ReassignSpeakerDialog.xaml's single-bool
                     comment cites: default IsEnabled=False, a DataTrigger on IsEditMode==False
                     flips it back on. Visibility (HasVersions) is unchanged/independent. -->
                <ComboBox ItemsSource="{Binding VersionOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedVersionOption}"
                          MinWidth="130" Margin="0,0,12,4" VerticalAlignment="Center"
                          ToolTip="Transcript version. Switching changes which transcript this session shows, edits, and exports; the original v1 is always preserved. Disabled while editing."
                          Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="False">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBlock Text="Recovered" Style="{StaticResource WarningText}" Margin="0,0,8,4" VerticalAlignment="Center"
                           ToolTip="Recovered after an interruption; duration is transcript-derived, not wall-clock"
                           Visibility="{Binding Recovered, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="Edited" Style="{StaticResource WarningText}" Margin="0,0,8,4" VerticalAlignment="Center"
                           Visibility="{Binding Edited, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="System mix" Style="{StaticResource WarningText}" Margin="0,0,8,4" VerticalAlignment="Center"
                           ToolTip="Remote audio came from the system-wide mix; other apps' audio may be present"
                           Visibility="{Binding SystemMix, Converter={StaticResource BoolToVis}}" />
                <Button Content="Split speakers..." Click="OnSplitSpeakers" Margin="0,0,8,4"
                        IsEnabled="{Binding CanDiarise}"
                        Visibility="{Binding CanDiarise, Converter={StaticResource BoolToVis}}" />
                <!-- Task 14: Edit-mode toggle. These are direct (un-templated) header children, so
                     a plain Command binding via ElementName=Self reaches the window's own commands
                     (the window's DataContext is the VM, not the window itself) - no WindowProxy
                     needed here (that's reserved for controls declared inside a Style/DataTemplate,
                     e.g. the row ContextMenu below). Edit needs BOTH "not already editing" AND
                     "session is editable"; WPF has no built-in AND-of-two-bools converter and this
                     project has none of its own, so a MultiDataTrigger drives its own Visibility
                     (same house fallback ReassignSpeakerDialog.xaml uses for a single inverse bool). -->
                <Button Content="Find" ToolTip="Find in transcript (Ctrl+F)" Margin="0,0,8,4"
                        Command="{Binding OpenFindCommand, ElementName=Self}" />
                <Button Content="Edit" Margin="0,0,8,4"
                        Command="{Binding EnterEditCommand, ElementName=Self}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEditMode}" Value="False" />
                                        <Condition Binding="{Binding CanEdit}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Save" Margin="0,0,8,4"
                        Command="{Binding SaveEditsCommand, ElementName=Self}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
                <Button Content="Cancel" Margin="0,0,8,4"
                        Command="{Binding CancelEditCommand, ElementName=Self}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
                <!-- Task 15: reaches the same Session Details window the row context menu's
                     Reassign-speaker dialog opens (identical _openSessionDetails callback), for
                     managing participant identities/names while already in Edit mode. -->
                <Button Content="Manage speakers..." Click="OnManageSpeakers" Margin="0,0,8,4"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
                <ToggleButton Content="Ask" Margin="0,0,8,4"
                              ToolTip="Ask the assistant about this session (summary + chat)"
                              IsChecked="{Binding Panel.IsOpen, ElementName=Self, Mode=TwoWay}"
                              Click="OnAskToggleClick" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding MatterDisplays}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mode=OneWay}" Opacity="0.8" Margin="0,0,8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ParticipantDisplays}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mode=OneWay}" Opacity="0.8" Margin="0,0,8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="System-audio mix was active for part of this session (degraded capture marker present)."
                       Style="{StaticResource WarningText}"
                       Visibility="{Binding HasDegradedMarker, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <!-- Ctrl+F find bar (design 2026-07-13 section 2.2 surface 3): searches the VISIBLE
             corrected text of the loaded version. Buttons bind window commands via ElementName=Self
             (direct children, same pattern as the Edit/Save header buttons); Enter/Shift+Enter/Esc
             are code-behind PreviewKeyDown on the box (KeyBindings outside the visual tree resolve
             neither ElementName nor DataContext reliably - the OnSegmentTextBoxPreviewKeyDown
             precedent). -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,4" CornerRadius="4"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                Visibility="{Binding IsFindOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Find" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Right" Content="Close" Margin="4,0,0,0"
                        Command="{Binding CloseFindCommand, ElementName=Self}" />
                <Button DockPanel.Dock="Right" Content="Next" Margin="4,0,0,0"
                        ToolTip="Next match (Enter)"
                        Command="{Binding FindNextCommand, ElementName=Self}" />
                <Button DockPanel.Dock="Right" Content="Previous" Margin="8,0,0,0"
                        ToolTip="Previous match (Shift+Enter)"
                        Command="{Binding FindPreviousCommand, ElementName=Self}" />
                <Button DockPanel.Dock="Right" Content="Search all sessions" Margin="8,0,0,0"
                        ToolTip="Search every session for this text on the Search page"
                        Command="{Binding SearchAllSessionsCommand, ElementName=Self}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding FindStatus}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBox x:Name="FindBox" VerticalContentAlignment="Center"
                         Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnFindBoxPreviewKeyDown" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0"
                Visibility="{Binding Playback.IsAvailable, Converter={StaticResource BoolToVis}}">
            <!-- WrapPanel (not a non-wrapping StackPanel) so the control clusters below wrap to a
                 second row instead of clipping off the window edge when narrowed. Each logical
                 control (buttons; elapsed+seek+total; the mute toggles; each vol label+slider)
                 wraps as its own unit via an inner horizontal StackPanel, since the fixed-width
                 SeekSlider can't gracefully share a wrap line with everything else. -->
            <WrapPanel Orientation="Horizontal">
                <!-- Task 2 (app-mute-awareness): pill transport, mirrors Task 1's Record-console
                     pattern. Play/Pause and Stop are plain Buttons with a Command, so they take
                     PillButton directly/BasedOn like Task 1. IsPlaying/PlayPauseCaption/StopCommand
                     bindings are byte-identical to what was here before, just wrapped in an
                     icon+label StackPanel instead of a plain Content string. -->
                <Button Style="{StaticResource PillButton}"
                        Command="{Binding Playback.PlayPauseCommand}" Margin="0,0,12,4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Margin="0,0,6,0">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Play24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Playback.IsPlaying}" Value="True">
                                            <Setter Property="Symbol" Value="Pause24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Text="{Binding Playback.PlayPauseCaption}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding Playback.StopCommand}" Margin="0,0,12,4"
                        ToolTip="Stop and rewind to the start">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Stop24" FontSize="18" Margin="0,0,6,0" />
                        <TextBlock Text="Stop" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Item 7 (UX round 2026-08-02): follow-along toggle. ToggleButton cannot
                     BasedOn PillButton (it does not derive from Button), so the derived style
                     is BasedOn PillToggleButton and only adds the edit-mode disable: the read
                     list is collapsed while editing, so following it would scroll a hidden
                     control. No bool-inverting converter exists by house rule - the disable is
                     a Style + DataTrigger (same fallback as the version ComboBox above). The
                     icon-flip DataTrigger reads the pill's own IsChecked, the identical idiom
                     the mute pills below use, so checked shows the "arrows in motion" glyph. -->
                <ToggleButton Margin="0,0,12,4"
                              IsChecked="{Binding Playback.SyncTranscript}"
                              ToolTip="Keep the transcript scrolled to the line being played">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource PillToggleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Margin="0,0,6,0">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ArrowSyncOff20" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Symbol" Value="ArrowSync24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Text="Sync" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="{Binding Playback.PositionDisplay}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <!-- TwoWay on SliderValueMs (NOT PositionMs): Slider's own class handlers mark
                         track-click and arrow/Page/Home/End KeyDown Handled BEFORE any XAML instance
                         handler runs, so Preview*/KeyDown wiring here could never see those gestures.
                         The TwoWay binding fires for every WPF-side Value change regardless, and
                         PlaybackViewModel.OnSliderValueMsChanged commits the seek (Stage 5.4 smoke-fix). -->
                    <Slider x:Name="SeekSlider" Width="240" Minimum="0" VerticalAlignment="Center" Margin="0,0,4,0"
                            IsMoveToPointEnabled="True"
                            Maximum="{Binding Playback.DurationMs}"
                            Value="{Binding Playback.SliderValueMs, Mode=TwoWay}"
                            SmallChange="5000" LargeChange="30000"
                            Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted" />
                    <TextBlock Text="{Binding Playback.DurationDisplay}" VerticalAlignment="Center" />
                    <!-- Item 8 go-to box (Ctrl+G): type a stamp the way the transcript shows it
                         (relative m:ss / h:mm:ss, or wallclock HH:mm:ss), Enter jumps. The error
                         state is a quiet red outline on this wrapper Border with the text
                         retained - never a dialog - and clears on the next keystroke (VM
                         OnGoToTextChanged). A wrapper Border rather than a TextBox style so no
                         assumption is made about Wpf.Ui's implicit TextBox template.
                         UX round 2026-08-03: GoToText is auto-colon masked as the user types
                         (credit-card-expiry style, TimestampMask via OnGoToTextChanged), so a
                         Grid overlays a session-aware format hint (GoToPlaceholder) behind the
                         TextBox - the same IsHitTestVisible=False + Style/DataTrigger idiom the
                         split-child speaker placeholder above uses, since this repo has no
                         bool-inverting converter. Width widened 72->92 so "HH:mm:ss" never clips.
                         OnGoToBoxTextChanged (code-behind) restores the caret to the end after
                         every VM-driven rewrite, since WPF resets TextBox.CaretIndex to 0
                         whenever Text is reassigned out from under it. -->
                    <TextBlock Text="Go to" VerticalAlignment="Center" Margin="12,0,4,0" Opacity="0.8" />
                    <Border CornerRadius="4" BorderThickness="1" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GoToError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBox x:Name="GoToBox" Width="92" VerticalContentAlignment="Center"
                                     Text="{Binding GoToText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Jump to a time (Ctrl+G). Type the digits - the colon is added for you (1415 = 14:15). Press Enter."
                                     PreviewKeyDown="OnGoToBoxPreviewKeyDown"
                                     TextChanged="OnGoToBoxTextChanged" />
                            <TextBlock Text="{Binding GoToPlaceholder, Mode=OneWay}"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GoToText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
                <!-- Item 9 (UX round 2026-08-02) contextual mixer. Single-leg session (exactly
                     one leg on disk): muting or soloing the only channel is meaningless, so
                     there are no mute pills - just one plain "Volume" slider bound to the lone
                     leg via the VM's forwarding SingleLegVolume. Dual-leg session: a "Channels"
                     group of two labelled rows so the per-leg controls read as a playback
                     mixer, not stray recording controls. The LocalMuted/RemoteMuted/
                     LocalVolume/RemoteVolume bindings are byte-identical to the pre-regroup
                     markup - only grouping and visibility changed. ToggleButton does NOT derive
                     from Button, so the pills use the mirrored PillToggleButton style (not
                     PillButton); each icon-flip DataTrigger reads its own pill's IsChecked
                     (RelativeSource AncestorType=ToggleButton), so identical markup serves both
                     legs. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4"
                            Visibility="{Binding Playback.HasSingleLeg, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider Width="80" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            Value="{Binding Playback.SingleLegVolume}" />
                </StackPanel>
                <Border Margin="0,0,12,4" Padding="8,4" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Visibility="{Binding Playback.HasBothLegs, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Channels" FontSize="11" Opacity="0.7" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Local (my side)" VerticalAlignment="Center" MinWidth="130" Margin="0,0,8,0" />
                            <ToggleButton Style="{StaticResource PillToggleButton}"
                                          IsChecked="{Binding Playback.LocalMuted}" Margin="0,0,8,0"
                                          ToolTip="Silence the local (my microphone) leg">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon FontSize="18" Margin="0,0,6,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Mic24" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Symbol" Value="MicOff24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Text="Mute" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Slider Width="80" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                    Value="{Binding Playback.LocalVolume}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Remote (other party)" VerticalAlignment="Center" MinWidth="130" Margin="0,0,8,0" />
                            <ToggleButton Style="{StaticResource PillToggleButton}"
                                          IsChecked="{Binding Playback.RemoteMuted}" Margin="0,0,8,0"
                                          ToolTip="Silence the remote (other party) leg">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon FontSize="18" Margin="0,0,6,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Mic24" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Symbol" Value="MicOff24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Text="Mute" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Slider Width="80" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                    Value="{Binding Playback.RemoteVolume}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ModelBackendFooter}" Opacity="0.6" Margin="0,8,0,0" />
        <!-- The "now playing" highlight lives on each row's IsNowPlaying flag (ItemContainerStyle
             trigger below), NOT SelectedIndex: binding the highlight to selection meant the VM
             and the user's own click wrote the same property, silently discarding a real
             selection every ~150ms tick, and fired a UIA selection-changed announcement on every
             section advance. MouseDoubleClick still reads RowList.SelectedIndex in the code-behind
             for genuine user activation, now unpolluted by playback. -->
        <!-- Task 14: read list and edit list occupy the same Grid cell (DockPanel.LastChildFill),
             toggled by IsEditMode - only one is ever visible, so there is no layout overlap despite
             sharing the cell. RowList has no built-in inverse-bool converter to hide it on
             IsEditMode=True, so it falls back to the same Style+DataTrigger pattern
             ReassignSpeakerDialog.xaml already uses for a single inverse bool. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PanelColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
        <ListView x:Name="RowList" ItemsSource="{Binding Rows}"
                  MouseDoubleClick="OnRowActivated"
                  PreviewMouseWheel="OnRowListPreviewMouseWheel"
                  PreviewKeyDown="OnRowListPreviewKeyDown"
                  Thumb.DragStarted="OnRowListScrollThumbDragStarted"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <EventSetter Event="ContextMenuOpening" Handler="OnRowContextMenuOpening" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Correct text..."
                                          Command="{Binding Data.CorrectTextCommand, Source={StaticResource WindowProxy}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasSegments}" />
                                <MenuItem Header="Reassign speaker..."
                                          Command="{Binding Data.ReassignSpeakerCommand, Source={StaticResource WindowProxy}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasSegments}" />
                                <MenuItem Header="Reassign all of this speaker..."
                                          Command="{Binding Data.ReassignClusterCommand, Source={StaticResource WindowProxy}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasSegments}" />
                                <Separator />
                                <MenuItem Header="Remove speaker pin..."
                                          Command="{Binding Data.RemovePinCommand, Source={StaticResource WindowProxy}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasPin}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Same pale accent tint as SessionsPage.xaml's selected-row style, applied
                             to a data-bound flag instead of IsSelected. -->
                        <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.28" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- Find-bar highlights (design 2026-07-13 section 2.2): every match gets a
                             faint accent tint; the CURRENT match a strong one. Declared after
                             IsNowPlaying so an overlapping row shows its find state. Theme resources
                             only (no ARGB literals - XamlHygiene). -->
                        <DataTrigger Binding="{Binding IsFindMatch}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrentFindMatch}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.45" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Data.IsMarker}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding Data.StartMs, Mode=OneWay, Converter={StaticResource Stamp}, StringFormat='[{0}]'}" />
                            <Run Text="{Binding Data.DisplayName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text=" (edited)" FontStyle="Italic" Opacity="0.7"
                                   ToolTip="Contains corrected text; the machine original is preserved"
                                   Visibility="{Binding Data.HasCorrection, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                        <!-- ITEM 5: one interactive inline per segment (hover [mm:ss], double-click
                             seek, per-segment now-playing tint) via the SegmentText behavior; marker /
                             live rows have no Segments and fall back to plain Data.Text. -->
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                   local:SegmentText.Segments="{Binding Segments, Mode=OneWay}"
                                   local:SegmentText.FallbackText="{Binding Data.Text, Mode=OneWay}"
                                   local:SegmentText.SeekCommand="{Binding Data.SeekSegmentCommand, Source={StaticResource WindowProxy}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Data.IsMarker}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!-- Edit-mode table: one row per EditableSectionViewModel, collapsed (read-only Speaker |
             Time | Text) until clicked, then expanded (DataTrigger on IsEditing) into its
             segments. Virtualized the same way RowList is - all edit state lives on the VMs
             (EditableSectionViewModel/EditableSegmentViewModel), so container recycling across a
             data-triggered template is safe (nothing is cached on the visual tree). -->
        <ListView x:Name="EditList" ItemsSource="{Binding EditSections}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Style.Triggers>
                        <!-- Edit-aware Find (UX round 2026-08-02 item 1): the same two tints as
                             RowList's find triggers, driven by the section VM's mirrored flags.
                             Theme resources only (no ARGB literals - XamlHygiene). -->
                        <DataTrigger Binding="{Binding IsFindMatch}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrentFindMatch}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.45" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:EditableSectionViewModel}">
                    <Grid>
                        <!-- Collapsed: read-only Speaker | Time | Text. A click activates
                             BeginEdit via code-behind (needs TimestampsMode/StartedAtLocal from
                             the window/VM, which is why this is not a pure command). -->
                        <StackPanel x:Name="CollapsedPanel" Background="Transparent"
                                    MouseLeftButtonUp="OnEditRowActivated" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Row.DisplayName, Mode=OneWay}" />
                                <TextBlock Opacity="0.7" Margin="6,0,0,0"
                                           Text="{Binding Row.StartMs, Mode=OneWay, Converter={StaticResource Stamp}, StringFormat='[{0}]'}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Row.Text, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Expanded: one sub-row per segment. Time is still a read-only placeholder
                             here (Task 16 replaces it with an editable field); Task 15 replaces the
                             speaker placeholder with a real ComboBox - ItemsSource is THIS segment's
                             own SpeakerChoices (threaded per-Source from BeginEdit in the code-behind,
                             not a single window-wide list, since a section can mix Local/Remote
                             segments). SelectedItem binds straight to Speaker; a whole (unsplit)
                             segment's selection is pinned on Save (ReadViewViewModel.SaveEditsAsync),
                             a split child's selection rides along inside its SplitPartEdit. -->
                        <ItemsControl x:Name="ExpandedPanel" ItemsSource="{Binding Segments}" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EditableSegmentViewModel}">
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,4,0,4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Source, Mode=OneWay}" MinWidth="70" Opacity="0.8" />
                                                <Grid Margin="8,0,0,0">
                                                    <ComboBox ItemsSource="{Binding SpeakerChoices}"
                                                              DisplayMemberPath="Display"
                                                              SelectedItem="{Binding Speaker}"
                                                              MinWidth="160" />
                                                    <!-- Item 3.11: split child with no override inherits the
                                                         parent seq's speaker; say so instead of painting blank. -->
                                                    <TextBlock Text="{Binding SpeakerPlaceholder, Mode=OneWay}"
                                                               IsHitTestVisible="False" Opacity="0.6"
                                                               VerticalAlignment="Center" Margin="10,0,28,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SpeakerPlaceholder}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <!-- Whole (unsplit) segment: read-only stamp, same converter/format as the rest of
                                                     the reader. Hidden for a split child (Task 16). -->
                                                <TextBlock x:Name="WholeStamp" Opacity="0.7" Margin="8,0,0,0"
                                                           Text="{Binding StartMs, Mode=OneWay, Converter={StaticResource Stamp}}" />
                                                <!-- Split child: the start was DERIVED (character-proportional estimate, design
                                                     §3.3), so it is editable to 10 ms precision and flagged as an estimate.
                                                     LostFocus (TextBox default UpdateSourceTrigger) commits on tab-out/blur
                                                     rather than per keystroke, so a mid-typing partial string (e.g. "00:1")
                                                     never round-trips through ConvertBack. Collapsed for a whole segment. -->
                                                <StackPanel x:Name="SplitTimeEditor" Orientation="Horizontal"
                                                            Margin="8,0,0,0" Visibility="Collapsed">
                                                    <TextBox Text="{Binding StartMs, Converter={StaticResource MsStamp}}"
                                                             MinWidth="64" VerticalContentAlignment="Center"
                                                             ToolTip="Split point time is estimated - edit to correct (snaps to 10 ms)." />
                                                    <TextBlock Text="(estimated)" Opacity="0.6" FontStyle="Italic"
                                                               Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <!-- Revert-split (design §3.3): visible only on a split child. Reverts the
                                                     WHOLE seq's split (RevertSplit takes the seq, not the part), so any part's
                                                     button restores the single original segment. Plain Click= on a direct
                                                     DataTemplate child (not a Style.Setter ContextMenu), so no WindowProxy
                                                     is needed - same proven pattern as OnEditRowActivated/OnSplitSpeakers. -->
                                                <Button x:Name="RevertSplitButton" Content="Merge" Margin="8,0,0,0"
                                                        Click="OnRevertSplit" Visibility="Collapsed"
                                                        ToolTip="Undo this split; restores the original single segment" />
                                            </StackPanel>
                                            <TextBox Text="{Binding EditedText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="False" TextWrapping="Wrap"
                                                     local:FindSelection.Enable="True"
                                                     PreviewKeyDown="OnSegmentTextBoxPreviewKeyDown" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Bug fix (final review): gated on DerivedStart, NOT IsSplitChild. Every
                                             part of a split has IsSplitChild=true, including part 0, whose start
                                             is still the MACHINE floor (DerivedStart=false) - showing it as an
                                             editable "(estimated)" field let a user edit a non-estimate, which
                                             then failed EditStore.ApplySplitAsync's "first part inherits the
                                             machine start" check. -->
                                        <DataTrigger Binding="{Binding DerivedStart}" Value="True">
                                            <Setter TargetName="WholeStamp" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="SplitTimeEditor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Merge/revert stays gated on IsSplitChild: any part of a split seq may
                                             revert the whole sequence back to one segment. -->
                                        <DataTrigger Binding="{Binding IsSplitChild}" Value="True">
                                            <Setter TargetName="RevertSplitButton" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter TargetName="CollapsedPanel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ExpandedPanel" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource ControlFillColorSecondaryBrush}"
                          Visibility="{Binding Panel.IsOpen, ElementName=Self, Converter={StaticResource BoolToVis}}" />
            <controls:AssistantSidePanel Grid.Column="2"
                          DataContext="{Binding Panel, ElementName=Self}"
                          Visibility="{Binding Panel.IsOpen, ElementName=Self, Converter={StaticResource BoolToVis}}" />
        </Grid>
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>
