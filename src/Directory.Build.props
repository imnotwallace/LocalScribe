<Project>

  <!-- Version stamp (Tier 1 plan A, 2026-08-05, spec item T1-1). Scoped to src\ ON PURPOSE:
       MSBuild walks UP from each project and stops at the first Directory.Build.props, so this
       file reaches the eight shipping projects under src\ and never touches tools\
       (tools\generate-icon and tools\UiaProbe are build-time utilities, not products). tests\ has
       its own Directory.Build.props since F8 (2026-08-05), and it deliberately imports ONLY the
       shared build-output guard below - no version, no sha stamp. There is no parent props file in
       this repo; the single Import below is a shared TARGETS file, not a props chain.

       0.9.0 is deliberately pre-1.0: the product ships behind an installer only after Tier 1D.
       The NUMERIC version is what Assembly.GetName().Version yields and therefore what lands in
       every session.json AppVersion field - evidentiary, append-only data - so it stays short. -->
  <PropertyGroup>
    <Version>0.9.2</Version>

    <!-- MEASURED 2026-08-05 (SDK 10.0.302): the SDK's built-in source-link sets SourceRevisionId
         from git and appends "+<40-char sha>" to InformationalVersion all by itself. Left on, it
         stacks with the short sha stamped below and yields "0.9.0+g4ddb7d4.4ddb7d47ab606d0...".
         REJECTED: dropping our own target and living with the SDK's full sha - 40 hex characters
         in a Settings "About" line and in every support paste-in is unreadable, and the value
         cannot be shortened once the SDK has appended it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- The build-output guard, shared verbatim with tests\Directory.Build.props (F8, final
       whole-branch review, 2026-08-05). ONE copy of the target logic lives in the imported file;
       see its comment block for the full rationale and for why its repo-root derivation stays
       correct from both import sites. -->
  <Import Project="$(MSBuildThisFileDirectory)..\build\BuildOutputGuard.targets" />

  <!-- Stamps "<Version>+g<short sha>" into AssemblyInformationalVersionAttribute. Runs before the
       two SDK targets that consume the property. Every attribute below is a guard:
         Condition (on the target)  - projects that suppress assembly-info generation are skipped.
         Condition (on the Exec)    - a SOURCE DROP with no .git never even invokes git. Exists()
                                      is true for a directory AND for a file, which is what a
                                      linked git worktree has at its root - this repo is worked in
                                      worktrees, so the file form must keep working.
         ConsoleToMSBuild           - captures stdout into a property (there is no other way).
         ContinueOnError            - git missing from PATH must not fail the build.
         IgnoreExitCode             - a non-zero git exit (or cmd's 9009 for "not found") must not
                                      even raise a WARNING; the ExitCode output below is checked
                                      explicitly instead.
       MEASURED both ways 2026-08-05: with .git present the build stamps "0.9.0+g4ddb7d4"; with
       .git removed, and again with a nonexistent git executable, it stamps a bare "0.9.0" with
       0 warnings and 0 errors. -->
  <Target Name="StampGitShaIntoInformationalVersion"
          BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo"
          Condition="'$(GenerateAssemblyInfo)' != 'false'">
    <Exec Command="git -C &quot;$(MSBuildThisFileDirectory).&quot; rev-parse --short=7 HEAD"
          Condition="Exists('$(MSBuildThisFileDirectory)..\.git')"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_LsGitShaOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_LsGitShaExit" />
    </Exec>
    <PropertyGroup>
      <_LsGitSha Condition="'$(_LsGitShaExit)' == '0'">$(_LsGitShaOutput.Trim())</_LsGitSha>
      <!-- F12 (final whole-branch review, 2026-08-05): a SHAPE guard, because ConsoleToMSBuild
           captures stderr as well as stdout and flattens the captured ITEM LIST into this property
           joined with ';'. A git that SUCCEEDS while printing any line on stderr - a "warning:" on
           an unusual worktree, a detached-head or config notice - would otherwise make the property
           "warning...;4ddb7d4" and the stamp "0.9.0+gwarning...;4ddb7d4", breaking the Settings
           About line and every support paste-in. IgnoreExitCode plus the ExitCode check above
           catches a FAILING command; nothing caught a succeeding one with stderr noise.
           MSBuild has no regex in Conditions, so this uses the Regex property function (VERIFIED
           2026-08-05 on SDK 10.0.302: '4ddb7d4' -> True, 'warning: x;4ddb7d4' -> False, '' ->
           False). A rejected value clears the property and the fallback below stamps the bare
           $(Version), exactly as a source drop with no .git already does. NOT anchored to a fixed
           length: the "short=7" flag above is a MINIMUM and git lengthens an abbreviated sha when
           7 characters are
           ambiguous (see BuildVersionTests' {7,} pattern). -->
      <_LsGitSha Condition="'$(_LsGitSha)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(_LsGitSha)', '^[0-9a-f]+$'))"></_LsGitSha>
      <InformationalVersion Condition="'$(_LsGitSha)' != ''">$(Version)+g$(_LsGitSha)</InformationalVersion>
      <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- Drops other platforms' native binaries from every RID-specific publish (2026-10-21).
       MEASURED on the 0.9.2 publish: 572 MB of the 2.6 GB app folder could never load on the only
       platform the installer targets - assistant\runtimes\linux-x64 (510 MB, LLamaSharp.Backend.
       Cuda12's linux sub-package), runtimes\vulkan\linux-x64 (58 MB, Whisper.net.Runtime.Vulkan),
       and runtimes\win-arm64 + runtimes\win-x86 (3.4 MB, Whisper.net.Runtime's CPU builds; an x64
       process never loads either). All three packages copy their natives through their OWN build
       props/targets as Content/None items rather than as NuGet runtime assets, so the SDK's RID
       asset selection never sees them and `dotnet publish -r win-x64` copies every platform.

       Matches on the OUTPUT path, because both vendor layouts put the RID somewhere under
       runtimes\: LLamaSharp as runtimes\<rid>\native\<variant>\, Whisper.net as
       runtimes\<variant>\<rid>\. A file is dropped when it sits under a RID-named folder and no
       folder on its path is $(RuntimeIdentifier). The GPU/CPU variant folders (cuda, vulkan,
       cuda12, avx2) are not RID-shaped, so they are never matched. Order-independent of the
       Assistant's _PreserveLlamaCppNativeLayout, which hooks the same target: that one only
       rewrites win-x64-sourced items and they stay under runtimes\win-x64\ either way.

       Publish only: a plain build (no RuntimeIdentifier) keeps the full set in bin\, which costs
       nothing and changes nothing about how a dev run probes. tools\verify-no-foreign-natives.ps1
       is the independent check, run by build.ps1 over the assembled app folder. -->
  <Target Name="_DropOtherPlatformNatives"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_LsOtherPlatformNative Include="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/')), '(?i)^runtimes/(.+/)?(win|linux|osx|maccatalyst|ios|iossimulator|tvos|tvossimulator|android|browser|freebsd|illumos|solaris)(-[a-z0-9]+)+/')) And !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/')), '(?i)^runtimes/(.+/)?$(RuntimeIdentifier)/'))" />
      <ResolvedFileToPublish Remove="@(_LsOtherPlatformNative)" />
    </ItemGroup>
    <Message Importance="high" Condition="'@(_LsOtherPlatformNative)' != ''"
             Text="$(MSBuildProjectName): dropped @(_LsOtherPlatformNative->Count()) native file(s) for platforms other than $(RuntimeIdentifier) from the publish" />
  </Target>

</Project>
