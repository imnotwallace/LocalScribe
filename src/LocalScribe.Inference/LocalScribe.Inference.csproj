<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allow test project to access internal providers for unit tests. -->
    <InternalsVisibleTo Include="LocalScribe.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needs Core for AssistantException (error propagation). -->
    <ProjectReference Include="..\LocalScribe.Core\LocalScribe.Core.csproj" />
  </ItemGroup>

</Project>
