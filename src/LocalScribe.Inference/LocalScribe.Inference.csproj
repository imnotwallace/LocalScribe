<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allow test project to access internal providers for unit tests. -->
    <InternalsVisibleTo Include="LocalScribe.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needs AssistantException for error propagation (design section 4: named failures). -->
    <ProjectReference Include="..\LocalScribe.Core\LocalScribe.Core.csproj" />
    <!-- Needs LlamaEngine for local inference (the native GGUF loading is in the Assistant project). -->
    <ProjectReference Include="..\LocalScribe.Assistant\LocalScribe.Assistant.csproj" />
  </ItemGroup>

</Project>
