<UserControl x:Class="LocalScribe.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:LocalScribe.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="HideWhenNull" TargetType="TextBlock" BasedOn="{StaticResource WarningText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncProviderWarning}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Always-visible scrollbar (not the auto-hide overlay): a hidden-until-hover scrollbar on
         a long settings form is not discoverable. The empty implicit ScrollBar style opts this
         ScrollViewer out of Wpf.Ui's dynamic hover-to-reveal scrollbar (which stays hidden even at
         VerticalScrollBarVisibility="Visible"), falling back to the default always-visible WPF bar. -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" />
        </ScrollViewer.Resources>
        <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Storage" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Storage root" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding StorageRoot, Mode=OneWay}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Button Content="Choose folder..." Command="{Binding PickStorageRootCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Open folder" Command="{Binding OpenStorageRootCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HideWhenNull}"
                               Text="{Binding SyncProviderWarning, Mode=OneWay}" />
                    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                            Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding RestartRequiredNote, Mode=OneWay}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Style="{StaticResource FieldRow}">
                        <Button Content="Regenerate all projections"
                                Command="{Binding RegenerateAllProjectionsCommand}" Margin="0,0,8,0" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsRegenerating, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Width="120" Height="6" IsIndeterminate="True"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding RegenerateProgress, Mode=OneWay}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" sessions re-rendered" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Recording" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding RecordingApplyNote, Mode=OneWay}" Style="{StaticResource Note}" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Audio format" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AudioFormatChoices}"
                                  SelectedItem="{Binding AudioFormat}" MinWidth="140" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Remote capture" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding RemoteModeChoices}"
                                  SelectedItem="{Binding RemoteMode}" MinWidth="140" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldRow}" IsEnabled="{Binding IsPerProcess}">
                        <TextBlock Text="Per-app target" Style="{StaticResource FieldLabel}" />
                        <ComboBox IsEditable="True" IsTextSearchEnabled="False"
                                  ItemsSource="{Binding RemoteAppSuggestions}"
                                  Text="{Binding RemoteApp, UpdateSourceTrigger=LostFocus}" MinWidth="200"
                                  local:ComboBoxWatermark.Text="e.g. Webex, Zoom" />
                    </StackPanel>
                    <TextBlock Text="{Binding RemoteAppNote, Mode=OneWay}" Style="{StaticResource Note}" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding MicChoices}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedMic, Mode=TwoWay}" MinWidth="240" />
                    </StackPanel>
                    <TextBlock Text="Recording follows the Windows Communications default unless you pin a device. A pinned device that is unplugged at record time falls back to the default and is noted in the transcript."
                               Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Audio retention" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding AudioRetentionDisplay, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Console compact mode (design 2026-07-18 section 6). DEFAULT OFF; read at
                         each Start, so it applies to the next recording with no restart. -->
                    <CheckBox Content="Collapse the record console to a compact pill when recording starts"
                              IsChecked="{Binding CompactConsoleOnStart}" Margin="0,4,0,4" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Transcription" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ModelChoices}"
                                  ItemTemplate="{StaticResource WhisperModelItemTemplate}"
                                  SelectedValuePath="Name" SelectedValue="{Binding Model}"
                                  MinWidth="260" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Backend" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding BackendChoices}" SelectedItem="{Binding Backend}"
                                  MinWidth="140" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Language" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding LanguageChoices}"
                                  DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding Language}" MinWidth="140" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Identity" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Your name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelfName}" MinWidth="200" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Your role" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelfRole}" MinWidth="200" />
                    </StackPanel>
                    <TextBlock Text="{Binding IdentityNote, Mode=OneWay}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Privacy" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox Content="Hide LocalScribe windows from screen shares and recordings"
                              IsChecked="{Binding ExcludeWindowsFromCapture}" Margin="0,4,0,4" />
                    <CheckBox Content="Show the recording overlay pill"
                              IsChecked="{Binding OverlayEnabled}" Margin="0,4,0,4" />
                    <CheckBox Content="Hide the overlay from screen shares"
                              IsChecked="{Binding OverlayExcludeFromCapture}" Margin="0,4,0,4" />
                    <CheckBox Content="Show the session name in the overlay tooltip"
                              IsChecked="{Binding OverlayShowSessionName}" Margin="0,4,0,4" />
                    <CheckBox Content="Show the overlay level meter"
                              IsChecked="{Binding OverlayShowLevelMeter}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding LoggingRedactionNote, Mode=OneWay}"
                               Style="{StaticResource Note}" />
                </StackPanel>
            </ui:Card>

            <!-- Local assistant (design 2026-07-18 section 7.6): master toggle + manifest
                 model picker + fetch instructions. Strictly local-only; every artifact is an
                 AI-generated draft. Disabled-with-explainer until a model exists. -->
            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Assistant" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox Content="Enable the local assistant (session summaries)"
                              IsChecked="{Binding AssistantEnabled}" Margin="0,4,0,4" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AssistantModelChoices}"
                                  SelectedItem="{Binding AssistantModel}" MinWidth="240"
                                  IsEnabled="{Binding HasAssistantModels}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AssistantModelsNote, Mode=OneWay}"
                               Style="{StaticResource Note}" />
                    <TextBlock Text="{Binding AssistantHelperNote, Mode=OneWay}"
                               Style="{StaticResource Note}" />
                    <TextBlock Text="Runs entirely on this computer - transcript content never leaves the machine. Summaries are AI-generated drafts, not transcripts. Generation may take several minutes on CPU-only machines."
                               Style="{StaticResource Note}" />
                </StackPanel>
            </ui:Card>

            <!-- MCP Access (MCP server round, design 2026-07-26): consent for exposing selected
                 matters, read-only, to local MCP clients (e.g. Claude Desktop). Default dark -
                 nothing is exposed until this is enabled AND matters are ticked. Enabling asks for
                 an explicit confirm; disabling never does (turning exposure off can never be the
                 harmful direction) and does not clear the remembered allowlist. -->
            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="MCP Access" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap"
                               Text="Let MCP clients (for example Claude Desktop) search and read selected matters. Read-only, fully local, every read audited. Nothing is exposed until you enable this and tick matters." />
                    <CheckBox Content="Enable MCP access" IsChecked="{Binding McpEnabled}" Margin="0,8,0,4" />
                    <CheckBox Content="Include sessions not assigned to any matter"
                              IsChecked="{Binding McpAllowUnassigned}" Margin="0,0,0,8"
                              IsEnabled="{Binding McpEnabled}" />
                    <TextBlock Text="Exposed matters" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <ItemsControl ItemsSource="{Binding McpMatters}" IsEnabled="{Binding McpEnabled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsAllowed}" Margin="0,2,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Client registration" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <TextBox Text="{Binding McpConfigSnippet, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Copy config" Command="{Binding CopyMcpSnippetCommand}" Margin="0,0,8,0" />
                        <Button Content="Open audit log folder" Command="{Binding OpenMcpAuditFolderCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Claude Desktop: paste into claude_desktop_config.json. Claude Code: claude mcp add localscribe -- &lt;exe&gt; --storage-root &lt;root&gt;." />
                </StackPanel>
            </ui:Card>

            <!-- Voiceprints (design 2026-07-25): the screen that OWNS voiceprint deletion. Says
                 plainly what is stored, and makes removing it reliable: per-person delete-oldest /
                 delete-voiceprint / delete-person, plus the confirm-gated global purge. Copy is
                 deliberately non-forensic - this is a suggester, never voice identification. -->
            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Voiceprints" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding VoiceprintsNote, Mode=OneWay}"
                               Style="{StaticResource Note}" />

                    <TextBlock Text="Nothing is stored: no person on this computer has a saved voiceprint."
                               Style="{StaticResource Note}"
                               Visibility="{Binding HasNoPeople, Converter={StaticResource BoolToVis}}" />

                    <!-- The truth is unknown (people.json could not be read), never the "nothing is
                         stored" claim above - styled as a critical warning, matching PurgeIncomplete
                         below (fix round 1, finding 1). -->
                    <TextBlock Text="{Binding PeopleUnreadableNote, Mode=OneWay}"
                               Style="{StaticResource Note}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding PeopleUnreadable, Converter={StaticResource BoolToVis}}" />

                    <!-- Re-entrancy gate (final review, I2): the container binds
                         VoiceprintCommandsEnabled, which OVERRIDES the automatic disable a bound
                         Command's CanExecute would otherwise apply for its children. WPF's
                         IsEnabled is inherited, so gating the container disables ALL THREE row
                         buttons while any voiceprint command runs - "Delete voiceprint" and
                         "Delete oldest" ALSO set their own explicit IsEnabled (HasEnrollments, so
                         they disable individually with nothing to delete); "Delete person" has no
                         explicit IsEnabled of its own and relies solely on the container gate plus
                         its Command's CanExecute. The two action buttons below need nothing: no
                         explicit IsEnabled, so CanExecute disables them. -->
                    <ItemsControl ItemsSource="{Binding People}" Margin="0,8,0,0"
                                  IsEnabled="{Binding VoiceprintCommandsEnabled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Delete person"
                                                Margin="4,0,0,0"
                                                ToolTip="Removes this person and any saved voiceprint. Names already written into transcripts are not changed."
                                                Command="{Binding DataContext.DeletePersonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button DockPanel.Dock="Right" Content="Delete voiceprint"
                                                Margin="4,0,0,0" IsEnabled="{Binding HasEnrollments}"
                                                ToolTip="Deletes every saved voiceprint for this person. They keep their name."
                                                Command="{Binding DataContext.DeleteVoiceprintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button DockPanel.Dock="Right" Content="Delete oldest"
                                                Margin="4,0,0,0" IsEnabled="{Binding HasEnrollments}"
                                                ToolTip="Deletes only this person's oldest saved voiceprint."
                                                Command="{Binding DataContext.DeleteEnrollmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <!-- Two TextBlocks, not Runs with a LineBreak: a person
                                             with nothing stored must read as a plain name, not a
                                             name followed by a blank line. -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding EnrollmentSummary, Mode=OneWay}"
                                                       TextWrapping="Wrap" Opacity="0.7"
                                                       Visibility="{Binding HasEnrollments, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource WarningText}"
                                               Text="{Binding DataContext.ReenrollNote, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Visibility="{Binding NeedsReenroll, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Scan sessions and enroll known speakers"
                                Command="{Binding BackfillScanCommand}" />
                        <Button Content="Purge all voiceprint data" Margin="8,0,0,0"
                                Command="{Binding PurgeVoiceprintsCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BackfillNote, Mode=OneWay}" Style="{StaticResource Note}" />
                    <TextBlock Text="{Binding BackfillStatus, Mode=OneWay}" Style="{StaticResource Note}" />
                    <!-- A partially-failed purge must never READ like a clean one: PurgeIncomplete
                         flips this line from a muted note to a critical warning. -->
                    <TextBlock Text="{Binding PurgeStatus, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PurgeIncomplete}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Call detection" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox Content="Offer to record when a call app starts using the microphone"
                              IsChecked="{Binding CallDetectEnabled}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding CallDetectNote, Mode=OneWay}" Style="{StaticResource Note}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Watched apps" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding CallDetectApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" MinWidth="220" />
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveCallDetectAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox MinWidth="220"
                                 Text="{Binding NewCallDetectApp, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Add" Margin="8,0,0,0"
                                Command="{Binding AddCallDetectAppCommand}" />
                        <Button Content="Reset to defaults" Margin="8,0,0,0"
                                Command="{Binding ResetCallDetectAppsCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Custom vocabulary" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap"
                               Text="Bias terms nudge the recognizer toward in-domain spellings; corrections fix mis-hearings when transcripts are rendered. Applies at the next recording / re-render, not to a session already running or the live view." />

                    <TextBlock Text="Terms" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding Vocabulary.Terms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" MinWidth="220" />
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.Vocabulary.RemoveTermCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox MinWidth="220"
                                 Text="{Binding Vocabulary.NewTerm, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Add" Margin="8,0,0,0"
                                Command="{Binding Vocabulary.AddTermCommand}" />
                    </StackPanel>

                    <TextBlock Text="Corrections (heard -&gt; correct)" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding Vocabulary.Corrections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Heard}" VerticalAlignment="Center" MinWidth="120" />
                                    <TextBlock Text="-&gt;" VerticalAlignment="Center" Margin="4,0" />
                                    <TextBlock Text="{Binding Correct}" VerticalAlignment="Center" MinWidth="120" />
                                    <Button Content="Remove" Margin="8,0,0,0"
                                            Command="{Binding DataContext.Vocabulary.RemoveCorrectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox MinWidth="120"
                                 Text="{Binding Vocabulary.NewHeard, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox MinWidth="120" Margin="8,0,0,0"
                                 Text="{Binding Vocabulary.NewCorrect, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Add" Margin="8,0,0,0"
                                Command="{Binding Vocabulary.AddCorrectionCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Export" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Filename template" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ExportFilenameTemplate, UpdateSourceTrigger=LostFocus}"
                                 Width="260" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExportTemplateTokens, Mode=OneWay}"
                               Style="{StaticResource Note}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="App" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox Content="Start LocalScribe when you sign in to Windows"
                              IsChecked="{Binding LaunchAtLogin}" Margin="0,4,0,4" />
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Timestamps" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding TimestampChoices}"
                                  SelectedItem="{Binding Timestamps}" MinWidth="140" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
